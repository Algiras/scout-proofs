/-! SCOUT: Authorization reservations against the root epoch (unbounded time and epochs).

Generated by export.py from the transition system in scout_smt.py.
Each theorem is one inductive-invariant obligation; the invariant is the
conjunction of the safety properties and the auxiliary facts. -/

namespace Scout.Authorization

set_option maxHeartbeats 2000000

/-- Safety properties (the first conjuncts) and auxiliary invariant. -/
def Inv (stage : Int) (resEpoch : Int) (epoch : Int) (rootClosed : Bool) (now : Int) (sawOpen : Bool) (badRes : Bool) (badDispatch : Bool) (expiry : Int) : Prop :=
  ((¬ (badRes = true)) ∧ (¬ (badDispatch = true)) ∧ ((stage ≥ (0 : Int)) ∧ (stage ≤ (2 : Int))) ∧ ((stage ≥ (1 : Int)) → (resEpoch ≤ epoch)) ∧ (¬ (sawOpen = true)))

theorem init (stage : Int) (resEpoch : Int) (epoch : Int) (rootClosed : Bool) (now : Int) (sawOpen : Bool) (badRes : Bool) (badDispatch : Bool) (expiry : Int)
    (hInit : ((stage = (0 : Int)) ∧ (epoch = (0 : Int)) ∧ (¬ (rootClosed = true)) ∧ (now = (0 : Int)) ∧ (¬ (sawOpen = true)) ∧ (¬ (badRes = true)) ∧ (¬ (badDispatch = true)))) :
    Inv stage resEpoch epoch rootClosed now sawOpen badRes badDispatch expiry := by
  unfold Inv
  intros
  simp only [Bool.not_eq_true] at *
  grind

/-- The invariant is preserved by `Reserve`. -/
theorem step_Reserve (stage : Int) (resEpoch : Int) (epoch : Int) (rootClosed : Bool) (now : Int) (sawOpen : Bool) (badRes : Bool) (badDispatch : Bool) (expiry : Int) 
    (hInv : Inv stage resEpoch epoch rootClosed now sawOpen badRes badDispatch expiry)
    (hGuard : ((stage = (0 : Int)) ∧ (¬ (rootClosed = true)) ∧ (now < expiry))) :
    ((¬ ((badRes = true) ∨ (rootClosed = true) ∨ (now ≥ expiry))) ∧ (¬ (badDispatch = true)) ∧ (((1 : Int) ≥ (0 : Int)) ∧ ((1 : Int) ≤ (2 : Int))) ∧ (((1 : Int) ≥ (1 : Int)) → (epoch ≤ epoch)) ∧ (¬ (sawOpen = true))) := by
  unfold Inv at hInv
  intros
  simp only [Bool.not_eq_true] at *
  grind

/-- The invariant is preserved by `Dispatch`. -/
theorem step_Dispatch (stage : Int) (resEpoch : Int) (epoch : Int) (rootClosed : Bool) (now : Int) (sawOpen : Bool) (badRes : Bool) (badDispatch : Bool) (expiry : Int) 
    (hInv : Inv stage resEpoch epoch rootClosed now sawOpen badRes badDispatch expiry)
    (hGuard : ((stage = (1 : Int)) ∧ (resEpoch = epoch) ∧ (¬ (rootClosed = true)) ∧ (now < expiry))) :
    ((¬ (badRes = true)) ∧ (¬ ((badDispatch = true) ∨ (¬ (resEpoch = epoch)))) ∧ (((2 : Int) ≥ (0 : Int)) ∧ ((2 : Int) ≤ (2 : Int))) ∧ (((2 : Int) ≥ (1 : Int)) → (resEpoch ≤ epoch)) ∧ (¬ (sawOpen = true))) := by
  unfold Inv at hInv
  intros
  simp only [Bool.not_eq_true] at *
  grind

/-- The invariant is preserved by `Cancel`. -/
theorem step_Cancel (stage : Int) (resEpoch : Int) (epoch : Int) (rootClosed : Bool) (now : Int) (sawOpen : Bool) (badRes : Bool) (badDispatch : Bool) (expiry : Int) 
    (hInv : Inv stage resEpoch epoch rootClosed now sawOpen badRes badDispatch expiry)
    (hGuard : (¬ (rootClosed = true))) :
    ((¬ (badRes = true)) ∧ (¬ (badDispatch = true)) ∧ ((stage ≥ (0 : Int)) ∧ (stage ≤ (2 : Int))) ∧ ((stage ≥ (1 : Int)) → (resEpoch ≤ (epoch + (1 : Int)))) ∧ (¬ (sawOpen = true))) := by
  unfold Inv at hInv
  intros
  simp only [Bool.not_eq_true] at *
  grind

/-- The invariant is preserved by `Tick`. -/
theorem step_Tick (stage : Int) (resEpoch : Int) (epoch : Int) (rootClosed : Bool) (now : Int) (sawOpen : Bool) (badRes : Bool) (badDispatch : Bool) (expiry : Int) 
    (hInv : Inv stage resEpoch epoch rootClosed now sawOpen badRes badDispatch expiry)
    (hGuard : True) :
    ((¬ (badRes = true)) ∧ (¬ (badDispatch = true)) ∧ ((stage ≥ (0 : Int)) ∧ (stage ≤ (2 : Int))) ∧ ((stage ≥ (1 : Int)) → (resEpoch ≤ epoch)) ∧ (¬ (sawOpen = true))) := by
  unfold Inv at hInv
  intros
  simp only [Bool.not_eq_true] at *
  grind

/-- A1 no reservation after closure or expiry. -/
theorem safe_A1 (stage : Int) (resEpoch : Int) (epoch : Int) (rootClosed : Bool) (now : Int) (sawOpen : Bool) (badRes : Bool) (badDispatch : Bool) (expiry : Int)
    (hInv : Inv stage resEpoch epoch rootClosed now sawOpen badRes badDispatch expiry) :
    (¬ (badRes = true)) := by
  unfold Inv at hInv
  intros
  simp only [Bool.not_eq_true] at *
  grind

/-- A2 no dispatch under a superseded epoch. -/
theorem safe_A2 (stage : Int) (resEpoch : Int) (epoch : Int) (rootClosed : Bool) (now : Int) (sawOpen : Bool) (badRes : Bool) (badDispatch : Bool) (expiry : Int)
    (hInv : Inv stage resEpoch epoch rootClosed now sawOpen badRes badDispatch expiry) :
    (¬ (badDispatch = true)) := by
  unfold Inv at hInv
  intros
  simp only [Bool.not_eq_true] at *
  grind

end Scout.Authorization
