(* broken: no commitment check; a refresh token is stolen *)
(* generated by gen.py; do not edit *)

(* ---------- channels ---------- *)
free net: channel.                 (* public network, controlled by the attacker *)
free bp: channel [private].        (* broker <-> provider back channel; each request carries a fresh reply channel *)
free hreq: channel [private].      (* requester -> honest runner: session id and session secret *)
free hprin: channel [private].     (* requester -> honest principal: consent link *)
free cons: channel [private].      (* honest principal's authenticated consent at the broker *)

(* ---------- cryptography ---------- *)
type skey. type pkey. type sskey. type spkey. type key. type nonce.
fun pk(skey): pkey.
fun spk(sskey): spkey.
(* server-authenticated transport: request encrypted to the broker, reply under a fresh key *)
fun tenc(bitstring, pkey): bitstring.
reduc forall m: bitstring, k: skey; tdec(tenc(m, pk(k)), k) = m.
fun senc(bitstring, key): bitstring.
reduc forall m: bitstring, k: key; sdec(senc(m, k), k) = m.
(* sealing to the runner key with associated data *)
fun seal(bitstring, pkey, bitstring, nonce): bitstring.
reduc forall m: bitstring, k: skey, ad: bitstring, r: nonce; unseal(seal(m, pk(k), ad, r), k, ad) = m.
fun sign(bitstring, sskey): bitstring.
reduc forall m: bitstring, k: sskey; checksign(sign(m, k), spk(k)) = m.
reduc forall m: bitstring, k: sskey; getmsg(sign(m, k)) = m.
fun hmac(bitstring, key): bitstring.
fun h(bitstring): bitstring.

const exch, refr, fetchTag, renewTag, tagAT, tagRT, zero, one: bitstring.

(* ---------- provider state ---------- *)
table tok(bitstring, bitstring, bool).   (* initial refresh token, grant, grant approved by the honest principal *)
table tok2(bitstring, bitstring, bool).  (* rotated refresh token; one rotation is modelled, so it is not refreshed again *)

event HonestToken(bitstring).     (* any token issued under an honest grant *)
event HonestNew(bitstring).       (* a token issued by refreshing an honest grant *)
event Committed(bitstring, bitstring).      (* broker bound this refresh token to this session *)
event BrokerRefresh(bitstring, bitstring).  (* broker used the client credential for (session, token) *)
event RunnerHolds(bitstring, bitstring).    (* honest runner accepted a refresh token for its session *)
event RunnerRenewed(bitstring, bitstring).  (* honest runner completed a renewal *)

(* Q1 *) query x: bitstring; event(HonestToken(x)) && attacker(x) ==> false.
(* Q2 *) query s: bitstring, t: bitstring; event(BrokerRefresh(s, t)) ==> event(Committed(s, t)).
(* Q3 *) query s: bitstring, t: bitstring; event(RunnerHolds(s, t)) ==> event(Committed(s, t)).
(* Q4 *) query x: bitstring; event(HonestNew(x)) && attacker(x) ==> false.
(* R  *) query s: bitstring, t: bitstring; event(RunnerRenewed(s, t)).

let Provider(cs: bitstring) =
  ( ! in(bp, (=exch, =cs, hon: bool, rc: channel));
      new at: bitstring; new rt: bitstring; new g: bitstring;
      insert tok(rt, g, hon);
      if hon = true then (event HonestToken(at); event HonestToken(rt); out(rc, (at, rt, g)))
      else out(rc, (at, rt, g)) )
  | ( ! in(bp, (=refr, =cs, rtp: bitstring, rc: channel));
      get tok(=rtp, g, hon) in
      new at2: bitstring; new rt2: bitstring;
      insert tok2(rt2, g, hon);
      if hon = true then (event HonestToken(at2); event HonestToken(rt2);
                          event HonestNew(at2); event HonestNew(rt2); out(rc, (at2, rt2)))
      else out(rc, (at2, rt2)) )
  | (* public token endpoint: anyone who has the client credential and a refresh token *)
    ( ! in(net, (=refr, =cs, rtp: bitstring));
      get tok(=rtp, g, hon) in
      new at2: bitstring; new rt2: bitstring;
      insert tok2(rt2, g, hon);
      if hon = true then (event HonestToken(at2); event HonestToken(rt2);
                          event HonestNew(at2); event HonestNew(rt2); out(net, (at2, rt2)))
      else out(net, (at2, rt2)) ).

let SessionH(skB: skey, cs: bitstring, kc: key, kstore: key, sid: bitstring, ss: bitstring, hon: bool) =
  out(net, (sid, h(ss)));                                  (* stored: hash of the session secret *)
  (* bind: pin the runner keys *)
  in(net, m1: bitstring);
  let ((=sid, =ss, pkE: pkey, vk: spkey), k1: key) = tdec(m1, skB) in
  (* consent: the locked principal for honest sessions, anyone for attacker sessions *)
  in(cons, =sid);
  (* provider exchange, seal, store, discard *)
  new rc1: channel; out(bp, (exch, cs, hon, rc1));
  in(rc1, (at: bitstring, rt: bitstring, g: bitstring));
  new gid: bitstring; new r1: nonce; new r2: nonce;
  let ctA = seal(at, pkE, (sid, gid, tagAT, zero), r1) in
  let ctR = seal(rt, pkE, (sid, gid, tagRT, zero), r2) in
  let cm = hmac((g, zero, rt), kc) in
  event Committed(sid, rt);
  out(net, (gid, ctA, ctR, cm ));                  (* stored: ciphertext and commitment *)
  (* signed grant retrieval *)
  in(net, m2: bitstring);
  let ((=sid, ts: bitstring, sg: bitstring), k2: key) = tdec(m2, skB) in
  if checksign(sg, vk) = (fetchTag, sid, ts) then
  out(net, senc((gid, ctA, ctR), k2));
  (* renewal of generation zero *)
  in(net, m3: bitstring);
  let ((=sid, rtp: bitstring, opid: bitstring, sg3: bitstring), k3: key) = tdec(m3, skB) in
  if checksign(sg3, vk) = (renewTag, sid, h(rtp), opid) then
  
  event BrokerRefresh(sid, rtp);
  new rc2: channel; out(bp, (refr, cs, rtp, rc2));
  in(rc2, (at2: bitstring, rt2: bitstring));
  new gid2: bitstring; new r3: nonce; new r4: nonce;
  let ctA2 = seal(at2, pkE, (sid, gid2, tagAT, one), r3) in
  let ctR2 = seal(rt2, pkE, (sid, gid2, tagRT, one), r4) in
  let cm2 = hmac((g, one, rt2), kc) in
  event Committed(sid, rt2);
  out(net, (gid2, ctA2, ctR2, cm2 ));              (* stored: sealed reply and next commitment *)
  out(net, senc((gid2, ctA2, ctR2), k3)).

let SessionA(skB: skey, cs: bitstring, kc: key, kstore: key, sid: bitstring, ss: bitstring, hon: bool) =
  out(net, (sid, h(ss)));                                  (* stored: hash of the session secret *)
  (* bind: pin the runner keys *)
  in(net, m1: bitstring);
  let ((=sid, =ss, pkE: pkey, vk: spkey), k1: key) = tdec(m1, skB) in
  (* consent: the locked principal for honest sessions, anyone for attacker sessions *)
  in(net, =sid);
  (* provider exchange, seal, store, discard *)
  new rc1: channel; out(bp, (exch, cs, hon, rc1));
  in(rc1, (at: bitstring, rt: bitstring, g: bitstring));
  new gid: bitstring; new r1: nonce; new r2: nonce;
  let ctA = seal(at, pkE, (sid, gid, tagAT, zero), r1) in
  let ctR = seal(rt, pkE, (sid, gid, tagRT, zero), r2) in
  let cm = hmac((g, zero, rt), kc) in
  event Committed(sid, rt);
  out(net, (gid, ctA, ctR, cm ));                  (* stored: ciphertext and commitment *)
  (* signed grant retrieval *)
  in(net, m2: bitstring);
  let ((=sid, ts: bitstring, sg: bitstring), k2: key) = tdec(m2, skB) in
  if checksign(sg, vk) = (fetchTag, sid, ts) then
  out(net, senc((gid, ctA, ctR), k2));
  (* renewal of generation zero *)
  in(net, m3: bitstring);
  let ((=sid, rtp: bitstring, opid: bitstring, sg3: bitstring), k3: key) = tdec(m3, skB) in
  if checksign(sg3, vk) = (renewTag, sid, h(rtp), opid) then
  
  event BrokerRefresh(sid, rtp);
  new rc2: channel; out(bp, (refr, cs, rtp, rc2));
  in(rc2, (at2: bitstring, rt2: bitstring));
  new gid2: bitstring; new r3: nonce; new r4: nonce;
  let ctA2 = seal(at2, pkE, (sid, gid2, tagAT, one), r3) in
  let ctR2 = seal(rt2, pkE, (sid, gid2, tagRT, one), r4) in
  let cm2 = hmac((g, one, rt2), kc) in
  event Committed(sid, rt2);
  out(net, (gid2, ctA2, ctR2, cm2 ));              (* stored: sealed reply and next commitment *)
  out(net, senc((gid2, ctA2, ctR2), k3)).

let Broker(skB: skey, cs: bitstring, kc: key, kstore: key) =
  ( ! new sid: bitstring; new ss: bitstring;               (* session for the honest principal *)
      out(hprin, sid);
      ( out(hreq, (sid, ss))                               (* handoff to the honest runner; it may arrive late *)
        | SessionH(skB, cs, kc, kstore, sid, ss, true) ) )
  | ( ! new sid: bitstring; new ss: bitstring;             (* session requested by the attacker *)
      out(net, (sid, ss));
      SessionA(skB, cs, kc, kstore, sid, ss, false) ).

let Principal() = ! in(hprin, sid: bitstring); out(cons, sid).

let Runner(pkB: pkey) =
  ! in(hreq, (sid: bitstring, ss: bitstring));
    new skE: skey; new skS: sskey; new k1: key;
    out(net, tenc(((sid, ss, pk(skE), spk(skS)), k1), pkB));
    new ts: bitstring; new k2: key;
    out(net, tenc(((sid, ts, sign((fetchTag, sid, ts), skS)), k2), pkB));
    in(net, c: bitstring);
    let (gid: bitstring, ctA: bitstring, ctR: bitstring) = sdec(c, k2) in
    let at = unseal(ctA, skE, (sid, gid, tagAT, zero)) in
    let rt = unseal(ctR, skE, (sid, gid, tagRT, zero)) in
    event RunnerHolds(sid, rt);
    out(net, rt);
    new opid: bitstring; new k3: key;
    out(net, tenc(((sid, rt, opid, sign((renewTag, sid, h(rt), opid), skS)), k3), pkB));
    in(net, c2: bitstring);
    let (gid2: bitstring, ctA2: bitstring, ctR2: bitstring) = sdec(c2, k3) in
    let at2 = unseal(ctA2, skE, (sid, gid2, tagAT, one)) in
    let rt2 = unseal(ctR2, skE, (sid, gid2, tagRT, one)) in
    event RunnerHolds(sid, rt2);
    event RunnerRenewed(sid, rt2).

process
  new skB: skey; new cs: bitstring; new kc: key; new kstore: key;
  out(net, pk(skB));
  
  ( Provider(cs) | Broker(skB, cs, kc, kstore) | Principal() | Runner(pk(skB)) )
