(assert (and (<= count0 1) (not badIssue) (not badLate) (>= gen 0) (>= g0 0) (=> (< gen g0) (= count0 0)) (=> (= gen g0) (= count0 (ite reserved 1 0))) (=> (> gen g0) (<= count0 1))))
(assert (and (and (not closed) live (not reserved) (= runnerDig commitDig)) (= gen_n gen) (= reserved_n true) (= resOp_n op) (= expired_n false) (= exchanged_n false) (= closed_n closed) (= live_n live) (= commitDig_n commitDig) (= runnerDig_n runnerDig) (= count0_n (+ count0 (ite (= gen g0) 1 0))) (= badIssue_n (or badIssue closed (not live) (not (= runnerDig commitDig)))) (= badLate_n badLate)))
(assert (not (and (<= count0_n 1) (not badIssue_n) (not badLate_n) (>= gen_n 0) (>= g0 0) (=> (< gen_n g0) (= count0_n 0)) (=> (= gen_n g0) (= count0_n (ite reserved_n 1 0))) (=> (> gen_n g0) (<= count0_n 1)))))
