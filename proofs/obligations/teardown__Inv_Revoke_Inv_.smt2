(declare-const closed Bool)
(declare-const deleted Bool)
(declare-const keyPresent Bool)
(declare-const saved Bool)
(declare-const bindings Bool)
(declare-const reportedRevoked Bool)
(declare-const provAck Bool)
(declare-const badForeign Bool)
(declare-const badFalseAck Bool)
(declare-const badAfterClose Bool)
(declare-const badNoKey Bool)
(declare-const closed_n Bool)
(declare-const deleted_n Bool)
(declare-const keyPresent_n Bool)
(declare-const saved_n Bool)
(declare-const bindings_n Bool)
(declare-const reportedRevoked_n Bool)
(declare-const provAck_n Bool)
(declare-const badForeign_n Bool)
(declare-const badFalseAck_n Bool)
(declare-const badAfterClose_n Bool)
(declare-const badNoKey_n Bool)
(declare-const d Bool)
(declare-const resp Int)
(assert (and (not badForeign) (and (not badFalseAck) (=> reportedRevoked provAck)) (not badAfterClose) (and (=> deleted closed) (=> (not deleted) keyPresent)) (=> closed (and (not saved) (not bindings))) (not badNoKey)))
(assert (and (and keyPresent d (>= resp 1) (<= resp 4)) (= closed_n closed) (= deleted_n deleted) (= keyPresent_n keyPresent) (= saved_n saved) (= bindings_n bindings) (= reportedRevoked_n (= resp 1)) (= provAck_n (= resp 1)) (= badForeign_n (or badForeign (not d))) (= badFalseAck_n (or badFalseAck (and (= resp 1) (not (= resp 1))))) (= badAfterClose_n badAfterClose) (= badNoKey_n (or badNoKey (not keyPresent)))))
(assert (not (and (not badForeign_n) (and (not badFalseAck_n) (=> reportedRevoked_n provAck_n)) (not badAfterClose_n) (and (=> deleted_n closed_n) (=> (not deleted_n) keyPresent_n)) (=> closed_n (and (not saved_n) (not bindings_n))) (not badNoKey_n))))
(check-sat)
