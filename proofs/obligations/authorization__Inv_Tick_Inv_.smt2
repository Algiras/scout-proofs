(declare-const stage Int)
(declare-const resEpoch Int)
(declare-const epoch Int)
(declare-const rootClosed Bool)
(declare-const now Int)
(declare-const sawOpen Bool)
(declare-const badRes Bool)
(declare-const badDispatch Bool)
(declare-const stage_n Int)
(declare-const resEpoch_n Int)
(declare-const epoch_n Int)
(declare-const rootClosed_n Bool)
(declare-const now_n Int)
(declare-const sawOpen_n Bool)
(declare-const badRes_n Bool)
(declare-const badDispatch_n Bool)
(declare-const expiry Int)
(assert (and (not badRes) (not badDispatch) (and (>= stage 0) (<= stage 2)) (=> (>= stage 1) (<= resEpoch epoch)) (not sawOpen)))
(assert (and true (= stage_n stage) (= resEpoch_n resEpoch) (= epoch_n epoch) (= rootClosed_n rootClosed) (= now_n (+ now 1)) (= sawOpen_n sawOpen) (= badRes_n badRes) (= badDispatch_n badDispatch)))
(assert (not (and (not badRes_n) (not badDispatch_n) (and (>= stage_n 0) (<= stage_n 2)) (=> (>= stage_n 1) (<= resEpoch_n epoch_n)) (not sawOpen_n))))
(check-sat)
