/-! SCOUT: Signed single-use delivery record.

Generated by export.py from the transition system in scout_smt.py.
Each theorem is one inductive-invariant obligation; the invariant is the
conjunction of the safety properties and the auxiliary facts. -/

namespace Scout.Delivery

set_option maxHeartbeats 2000000

/-- Safety properties (the first conjuncts) and auxiliary invariant. -/
def Inv (status : Int) (delivered : Bool) (fp : Int) (resp : Int) (rel : Bool) (relResp : Int) (badDiff : Bool) (badRev : Bool) : Prop :=
  ((¬ (badDiff = true)) ∧ (¬ (badRev = true)) ∧ ((status ≥ (0 : Int)) ∧ (status ≤ (2 : Int))) ∧ ((status = (0 : Int)) → ((¬ (delivered = true)) ∧ (¬ (rel = true)))) ∧ ((status = (1 : Int)) → (delivered = true)) ∧ ((rel = true) → (delivered = true)) ∧ ((delivered = true) → ((rel = true) ∧ (relResp = resp))))

theorem init (status : Int) (delivered : Bool) (fp : Int) (resp : Int) (rel : Bool) (relResp : Int) (badDiff : Bool) (badRev : Bool)
    (hInit : ((status = (0 : Int)) ∧ (¬ (delivered = true)) ∧ (¬ (rel = true)) ∧ (¬ (badDiff = true)) ∧ (¬ (badRev = true)))) :
    Inv status delivered fp resp rel relResp badDiff badRev := by
  unfold Inv
  intros
  simp only [Bool.not_eq_true] at *
  grind

/-- The invariant is preserved by `Fetch`. -/
theorem step_Fetch (status : Int) (delivered : Bool) (fp : Int) (resp : Int) (rel : Bool) (relResp : Int) (badDiff : Bool) (badRev : Bool) (req : Int) (r : Int)
    (hInv : Inv status delivered fp resp rel relResp badDiff badRev)
    (hGuard : ((status = (0 : Int)) ∧ (¬ (delivered = true)))) :
    ((¬ ((badDiff = true) ∨ ((rel = true) ∧ (¬ (relResp = r))))) ∧ (¬ ((badRev = true) ∨ (status = (2 : Int)))) ∧ (((1 : Int) ≥ (0 : Int)) ∧ ((1 : Int) ≤ (2 : Int))) ∧ (((1 : Int) = (0 : Int)) → ((¬ True) ∧ (¬ True))) ∧ (((1 : Int) = (1 : Int)) → True) ∧ (True → True) ∧ (True → (True ∧ (r = r)))) := by
  unfold Inv at hInv
  intros
  simp only [Bool.not_eq_true] at *
  grind

/-- The invariant is preserved by `Refetch`. -/
theorem step_Refetch (status : Int) (delivered : Bool) (fp : Int) (resp : Int) (rel : Bool) (relResp : Int) (badDiff : Bool) (badRev : Bool) (req : Int)
    (hInv : Inv status delivered fp resp rel relResp badDiff badRev)
    (hGuard : ((status = (1 : Int)) ∧ (delivered = true) ∧ (req = fp))) :
    ((¬ ((badDiff = true) ∨ ((rel = true) ∧ (¬ (relResp = resp))))) ∧ (¬ ((badRev = true) ∨ (status = (2 : Int)))) ∧ ((status ≥ (0 : Int)) ∧ (status ≤ (2 : Int))) ∧ ((status = (0 : Int)) → ((¬ (delivered = true)) ∧ (¬ True))) ∧ ((status = (1 : Int)) → (delivered = true)) ∧ (True → (delivered = true)) ∧ ((delivered = true) → (True ∧ (resp = resp)))) := by
  unfold Inv at hInv
  intros
  simp only [Bool.not_eq_true] at *
  grind

/-- The invariant is preserved by `FetchOther`. -/
theorem step_FetchOther (status : Int) (delivered : Bool) (fp : Int) (resp : Int) (rel : Bool) (relResp : Int) (badDiff : Bool) (badRev : Bool) (req : Int)
    (hInv : Inv status delivered fp resp rel relResp badDiff badRev)
    (hGuard : ((status = (1 : Int)) ∧ (delivered = true) ∧ (¬ (req = fp)))) :
    ((¬ (badDiff = true)) ∧ (¬ (badRev = true)) ∧ (((2 : Int) ≥ (0 : Int)) ∧ ((2 : Int) ≤ (2 : Int))) ∧ (((2 : Int) = (0 : Int)) → ((¬ (delivered = true)) ∧ (¬ (rel = true)))) ∧ (((2 : Int) = (1 : Int)) → (delivered = true)) ∧ ((rel = true) → (delivered = true)) ∧ ((delivered = true) → ((rel = true) ∧ (relResp = resp)))) := by
  unfold Inv at hInv
  intros
  simp only [Bool.not_eq_true] at *
  grind

/-- The invariant is preserved by `Revoke`. -/
theorem step_Revoke (status : Int) (delivered : Bool) (fp : Int) (resp : Int) (rel : Bool) (relResp : Int) (badDiff : Bool) (badRev : Bool) 
    (hInv : Inv status delivered fp resp rel relResp badDiff badRev)
    (hGuard : True) :
    ((¬ (badDiff = true)) ∧ (¬ (badRev = true)) ∧ (((2 : Int) ≥ (0 : Int)) ∧ ((2 : Int) ≤ (2 : Int))) ∧ (((2 : Int) = (0 : Int)) → ((¬ (delivered = true)) ∧ (¬ (rel = true)))) ∧ (((2 : Int) = (1 : Int)) → (delivered = true)) ∧ ((rel = true) → (delivered = true)) ∧ ((delivered = true) → ((rel = true) ∧ (relResp = resp)))) := by
  unfold Inv at hInv
  intros
  simp only [Bool.not_eq_true] at *
  grind

/-- D1 every released response is the first one. -/
theorem safe_D1 (status : Int) (delivered : Bool) (fp : Int) (resp : Int) (rel : Bool) (relResp : Int) (badDiff : Bool) (badRev : Bool)
    (hInv : Inv status delivered fp resp rel relResp badDiff badRev) :
    (¬ (badDiff = true)) := by
  unfold Inv at hInv
  intros
  simp only [Bool.not_eq_true] at *
  grind

/-- D2 nothing is released after revocation. -/
theorem safe_D2 (status : Int) (delivered : Bool) (fp : Int) (resp : Int) (rel : Bool) (relResp : Int) (badDiff : Bool) (badRev : Bool)
    (hInv : Inv status delivered fp resp rel relResp badDiff badRev) :
    (¬ (badRev = true)) := by
  unfold Inv at hInv
  intros
  simp only [Bool.not_eq_true] at *
  grind

end Scout.Delivery
