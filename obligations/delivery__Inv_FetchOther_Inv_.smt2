(declare-const status Int)
(declare-const delivered Bool)
(declare-const fp Int)
(declare-const resp Int)
(declare-const rel Bool)
(declare-const relResp Int)
(declare-const badDiff Bool)
(declare-const badRev Bool)
(declare-const status_n Int)
(declare-const delivered_n Bool)
(declare-const fp_n Int)
(declare-const resp_n Int)
(declare-const rel_n Bool)
(declare-const relResp_n Int)
(declare-const badDiff_n Bool)
(declare-const badRev_n Bool)
(declare-const req Int)
(assert (and (not badDiff) (not badRev) (and (>= status 0) (<= status 2)) (=> (= status 0) (and (not delivered) (not rel))) (=> (= status 1) delivered) (=> rel delivered) (=> delivered (and rel (= relResp resp)))))
(assert (and (and (= status 1) delivered (not (= req fp))) (= status_n 2) (= delivered_n delivered) (= fp_n fp) (= resp_n resp) (= rel_n rel) (= relResp_n relResp) (= badDiff_n badDiff) (= badRev_n badRev)))
(assert (not (and (not badDiff_n) (not badRev_n) (and (>= status_n 0) (<= status_n 2)) (=> (= status_n 0) (and (not delivered_n) (not rel_n))) (=> (= status_n 1) delivered_n) (=> rel_n delivered_n) (=> delivered_n (and rel_n (= relResp_n resp_n))))))
(check-sat)
