(declare-const gen Int)
(declare-const reserved Bool)
(declare-const resOp Int)
(declare-const expired Bool)
(declare-const exchanged Bool)
(declare-const closed Bool)
(declare-const live Bool)
(declare-const commitDig Int)
(declare-const runnerDig Int)
(declare-const count0 Int)
(declare-const badIssue Bool)
(declare-const badLate Bool)
(declare-const gen_n Int)
