(assert (and (<= count0 1) (not badIssue) (not badLate) (>= gen 0) (>= g0 0) (=> (< gen g0) (= count0 0)) (=> (= gen g0) (= count0 (ite reserved 1 0))) (=> (> gen g0) (<= count0 1))))
(assert (and (and reserved (not closed)) (= gen_n (+ gen 1)) (= reserved_n false) (= resOp_n resOp) (= expired_n expired) (= exchanged_n exchanged) (= closed_n closed) (= live_n live) (= commitDig_n r) (= runnerDig_n runnerDig) (= count0_n count0) (= badIssue_n badIssue) (= badLate_n badLate)))
(assert (not (and (<= count0_n 1) (not badIssue_n) (not badLate_n) (>= gen_n 0) (>= g0 0) (=> (< gen_n g0) (= count0_n 0)) (=> (= gen_n g0) (= count0_n (ite reserved_n 1 0))) (=> (> gen_n g0) (<= count0_n 1)))))
(check-sat)
