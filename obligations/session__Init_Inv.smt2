(assert (not (and (not badMint) (=> minted (and keyPinned (= sealKey pinnedKey))) (not badUser) (=> term (>= st 4)) (and (>= st 0) (<= st 6)) (=> (= st 0) (and (not keyPinned) (not minted) (not anyConsent))) (=> (and (>= st 1) (<= st 3)) keyPinned) (=> minted anyConsent) (=> anyConsent (and locked (= firstUser lockedUser) keyPinned)) (=> (or (= st 2) (= st 3)) minted))))
